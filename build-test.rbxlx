            </Properties>
            <Item class="UIStroke" referent="121">
              <Properties>
                <string name="Name">UIStroke</string>
                <float name="Thickness">1</float>
                <float name="Transparency">0.5</float>
              </Properties>
            </Item>
            <Item class="UITextSizeConstraint" referent="122">
              <Properties>
                <string name="Name">UITextSizeConstraint</string>
                <int name="MaxTextSize">14</int>
                <int name="MinTextSize">8</int>
              </Properties>
            </Item>
