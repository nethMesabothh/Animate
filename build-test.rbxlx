                <YO>0</YO>
              </UDim2>
              <UDim2 name="Size">
                <XS>0.9</XS>
                <XO>0</XO>
                <YS>0.25</YS>
                <YO>0</YO>
              </UDim2>
              <string name="Text"></string>
              <Color3 name="TextColor3">
                <R>1</R>
                <G>1</G>
                <B>1</B>
              </Color3>
              <bool name="TextScaled">true</bool>
              <float name="TextSize">12</float>
