            </Properties>
          </Item>
          <Item class="ModuleScript" referent="163">
            <Properties>
              <string name="Name">LockOnController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local LockOnConfig = require(Shared.LockOnConfig)
local Packets = require(Shared.Packets)

local LockOnController = Knit.CreateController({
	Name = "LockOnController",
})

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local character: Model? = nil
local humanoid: Humanoid? = nil
local humanoidRootPart: BasePart? = nil

local locked = false
local currentTarget: BasePart? = nil
local savedCameraType: Enum.CameraType? = nil

local availableTargets: { BasePart } = {}
local threatArrows: { [BasePart]: ImageLabel } = {}

local screenGui: ScreenGui? = nil
local reticleBillboard: BillboardGui? = nil
local reticleImage: ImageLabel? = nil
local currentHighlight: Highlight? = nil

local inputConnection: RBXScriptConnection? = nil
local deathConnection: RBXScriptConnection? = nil

local targetRefreshTimer = 0
local smoothedCameraPosition: Vector3? = nil
local smoothedLookPosition: Vector3? = nil

local shiftLockController: any = nil

local function safeDisconnect(connection: RBXScriptConnection?): ()
	if connection then
		connection:Disconnect()
	end
end

local function getRoot(model: Model?): BasePart?
	if not model then
		return nil
	end

	return model:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function getTargetPoint(targetRoot: BasePart): Vector3
	return targetRoot.Position + Vector3.new(0, LockOnConfig.TargetLookHeight, 0)
end

local function hasLineOfSight(targetRoot: BasePart): boolean
	if not humanoidRootPart then
		return false
	end

	local origin = humanoidRootPart.Position
	local direction = getTargetPoint(targetRoot) - origin
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }

	local result = Workspace:Raycast(origin, direction, params)
	if not result then
		return true
	end

	return result.Instance:IsDescendantOf(targetRoot.Parent)
end

local function isValidTarget(root: BasePart?): boolean
	if not root or not root:IsA("BasePart") or not root.Parent then
		return false
	end

	if not character or not humanoidRootPart then
		return false
	end

	if root == humanoidRootPart then
		return false
	end

	local model = root.Parent
	if model == character then
		return false
	end

	if not CollectionService:HasTag(model, LockOnConfig.TargetTag) then
		return false
	end

	local targetHumanoid = model:FindFirstChildOfClass("Humanoid")
	if not targetHumanoid or targetHumanoid.Health <= 0 then
		return false
	end

	local distance = (humanoidRootPart.Position - root.Position).Magnitude
	if distance > LockOnConfig.MaxDistance then
		return false
	end

	if LockOnConfig.RequireLineOfSight and not hasLineOfSight(root) then
		return false
	end

	return true
end

local function gatherTargets(): ()
	table.clear(availableTargets)

	if not humanoidRootPart then
		return
	end

	for _, model in CollectionService:GetTagged(LockOnConfig.TargetTag) do
		if model:IsA("Model") then
			local root = getRoot(model)
			if root and isValidTarget(root) then
				table.insert(availableTargets, root)
			end
		end
	end

	table.sort(availableTargets, function(a, b)
		local da = (humanoidRootPart.Position - a.Position).Magnitude
		local db = (humanoidRootPart.Position - b.Position).Magnitude
		return da < db
	end)
end

local function createScreenGui(): ()
	local playerGui = player:WaitForChild("PlayerGui")

	local old = playerGui:FindFirstChild("LockOnThreatIndicators")
	if old then
		old:Destroy()
	end

	screenGui = Instance.new("ScreenGui")
	screenGui.Name = "LockOnThreatIndicators"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Parent = playerGui
end

local function removeReticle(): ()
	if reticleBillboard then
		reticleBillboard:Destroy()
	end

	reticleBillboard = nil
	reticleImage = nil
end

local function removeHighlight(): ()
	if currentHighlight then
		currentHighlight:Destroy()
	end

	currentHighlight = nil
end

local function clearThreatArrows(): ()
	for _, arrow in threatArrows do
		if arrow then
			arrow:Destroy()
		end
	end

	table.clear(threatArrows)
end

local function resetCameraSmoothing(): ()
	smoothedCameraPosition = nil
	smoothedLookPosition = nil
end

local function restoreCameraType(): ()
	if savedCameraType then
		camera.CameraType = savedCameraType
		savedCameraType = nil
	end
end

function LockOnController:Unlock(): ()
	if not locked and not currentTarget then
		return
	end

	locked = false
	currentTarget = nil
	targetRefreshTimer = 0

	removeReticle()
	removeHighlight()
	clearThreatArrows()
	resetCameraSmoothing()
	restoreCameraType()

	if humanoid then
		humanoid.AutoRotate = true
	end

	camera.FieldOfView = LockOnConfig.DefaultFov

	if shiftLockController then
		shiftLockController:Refresh()
	end
end

local function createReticle(target: BasePart): ()
	if not LockOnConfig.EnableReticle then
		return
	end

	removeReticle()

	reticleBillboard = Instance.new("BillboardGui")
	reticleBillboard.Name = "LockOnReticle"
	reticleBillboard.AlwaysOnTop = true
	reticleBillboard.LightInfluence = 0
	reticleBillboard.ResetOnSpawn = false
	reticleBillboard.Size = UDim2.fromOffset(LockOnConfig.ReticleSize, LockOnConfig.ReticleSize)
	reticleBillboard.StudsOffsetWorldSpace = Vector3.new(0, LockOnConfig.TargetLookHeight, 0)
	reticleBillboard.Parent = target

	reticleImage = Instance.new("ImageLabel")
	reticleImage.Name = "Reticle"
	reticleImage.BackgroundTransparency = 1
	reticleImage.AnchorPoint = Vector2.new(0.5, 0.5)
	reticleImage.Position = UDim2.fromScale(0.5, 0.5)
	reticleImage.Size = UDim2.fromScale(1, 1)
	reticleImage.Image = LockOnConfig.ReticleImage
	reticleImage.ImageColor3 = LockOnConfig.ReticleColor
	reticleImage.ImageTransparency = LockOnConfig.ReticleTransparency
	reticleImage.ScaleType = Enum.ScaleType.Fit
	reticleImage.Parent = reticleBillboard
end

local function createHighlight(target: BasePart): ()
	if not LockOnConfig.EnableHighlight then
		return
	end

	removeHighlight()

	currentHighlight = Instance.new("Highlight")
	currentHighlight.Name = "LockOnHighlight"
	currentHighlight.Adornee = target.Parent
	currentHighlight.DepthMode = Enum.HighlightDepthMode.Occluded
	currentHighlight.FillColor = LockOnConfig.HighlightFill
	currentHighlight.OutlineColor = LockOnConfig.HighlightOutline
	currentHighlight.FillTransparency = LockOnConfig.HighlightFillTransparency
	currentHighlight.OutlineTransparency = LockOnConfig.HighlightOutlineTransparency
	currentHighlight.Parent = target.Parent
end

local function setCurrentTarget(target: BasePart): ()
	if not isValidTarget(target) then
		LockOnController:Unlock()
		return
	end

	currentTarget = target
	createReticle(target)
	createHighlight(target)
end

local function scoreTarget(root: BasePart): number
	if not humanoidRootPart then
		return -1
	end

	local offset = root.Position - humanoidRootPart.Position
	local distance = offset.Magnitude
	if distance > LockOnConfig.MaxDistance then
		return -1
	end

	local lookDirection = camera.CFrame.LookVector
	local dot = lookDirection:Dot(offset.Unit)
	local angleScore = (dot + 1) / 2
	local distanceScore = 1 - distance / LockOnConfig.MaxDistance

	return angleScore * LockOnConfig.AngleWeight + distanceScore * LockOnConfig.DistanceWeight
end

local function findBestTarget(): BasePart?
	gatherTargets()

	local bestTarget: BasePart? = nil
	local bestScore = -1

	for _, target in availableTargets do
		local score = scoreTarget(target)
		if score > bestScore then
			bestScore = score
			bestTarget = target
		end
	end

	return bestTarget
end

local function switchTarget(direction: number): ()
	gatherTargets()

	if #availableTargets <= 1 then
		return
	end

	local currentIndex = table.find(availableTargets, currentTarget)
	if not currentIndex then
		setCurrentTarget(availableTargets[1])
		return
	end

	local newIndex = currentIndex + direction
	if newIndex > #availableTargets then
		newIndex = 1
	elseif newIndex < 1 then
		newIndex = #availableTargets
	end

	setCurrentTarget(availableTargets[newIndex])
end

local function getOrCreateArrow(target: BasePart): ImageLabel
	local existing = threatArrows[target]
	if existing then
		return existing
	end

	local arrow = Instance.new("ImageLabel")
	arrow.Name = "ThreatArrow"
	arrow.BackgroundTransparency = 1
	arrow.AnchorPoint = Vector2.new(0.5, 0.5)
	arrow.Size = UDim2.fromOffset(LockOnConfig.ArrowSize, LockOnConfig.ArrowSize)
	arrow.Image = LockOnConfig.ArrowImage
	arrow.ImageColor3 = LockOnConfig.ArrowColor
	arrow.ImageTransparency = 0
	arrow.ScaleType = Enum.ScaleType.Fit
	arrow.Visible = false
	arrow.ZIndex = 50
	arrow.Parent = screenGui

	threatArrows[target] = arrow
	return arrow
end

local function cleanupDeadArrows(): ()
	for target, arrow in threatArrows do
		if not isValidTarget(target) then
			if arrow then
				arrow:Destroy()
			end
			threatArrows[target] = nil
		end
	end
end

local function updateThreatArrows(): ()
	if not LockOnConfig.EnableThreatArrows or not screenGui then
		return
	end

	cleanupDeadArrows()

	for _, target in availableTargets do
		if not isValidTarget(target) then
			continue
		end

		local arrow = getOrCreateArrow(target)

		if LockOnConfig.HideArrowForCurrentTarget and target == currentTarget then
			arrow.Visible = false
			continue
		end

		local screenPos, onScreen = camera:WorldToViewportPoint(target.Position)
		if onScreen and screenPos.Z > 0 then
			arrow.Visible = false
			continue
		end

		arrow.Visible = true

		local viewportSize = camera.ViewportSize
		local center = viewportSize / 2
		local point = Vector2.new(screenPos.X, screenPos.Y)

		if screenPos.Z < 0 then
			point = center - (point - center)
		end

		local direction = point - center
		if direction.Magnitude < 0.001 then
			direction = Vector2.new(0, -1)
		else
			direction = direction.Unit
		end

		local edgeX = math.clamp(
			center.X + direction.X * LockOnConfig.ArrowDistanceFromCenter,
			LockOnConfig.ArrowEdgePadding,
			viewportSize.X - LockOnConfig.ArrowEdgePadding
		)

		local edgeY = math.clamp(
			center.Y + direction.Y * LockOnConfig.ArrowDistanceFromCenter,
			LockOnConfig.ArrowEdgePadding,
			viewportSize.Y - LockOnConfig.ArrowEdgePadding
		)

		arrow.Position = UDim2.fromOffset(edgeX, edgeY)

		local angle = math.atan2(direction.Y, direction.X)
		arrow.Rotation = math.deg(angle) + 90

		local distance = (humanoidRootPart.Position - target.Position).Magnitude
		local scale = math.clamp(1 + (1 - distance / LockOnConfig.MaxDistance) * 0.45, 1, 1.45)
		arrow.Size = UDim2.fromOffset(LockOnConfig.ArrowSize * scale, LockOnConfig.ArrowSize * scale)
	end
end

local function updateCamera(dt: number): ()
	if not locked then
		return
	end

	if not currentTarget or not isValidTarget(currentTarget) then
		LockOnController:Unlock()
		return
	end

	if not humanoidRootPart then
		return
	end

	targetRefreshTimer += dt
	if targetRefreshTimer >= LockOnConfig.TargetRefreshRate then
		targetRefreshTimer = 0
		gatherTargets()
	end

	local rootPos = humanoidRootPart.Position
	local targetPos = getTargetPoint(currentTarget)

	local flatDirection = Vector3.new(targetPos.X - rootPos.X, 0, targetPos.Z - rootPos.Z)
	if flatDirection.Magnitude <= 0.001 then
		return
	end

	flatDirection = flatDirection.Unit

	local right = flatDirection:Cross(Vector3.yAxis)
	if right.Magnitude <= 0.001 then
		right = Vector3.new(1, 0, 0)
	else
		right = right.Unit
	end

	local desiredCameraPosition = rootPos
		- flatDirection * LockOnConfig.BackOffset
		+ right * LockOnConfig.SideOffset
		+ Vector3.new(0, LockOnConfig.HeightOffset, 0)

	if not smoothedCameraPosition then
		smoothedCameraPosition = desiredCameraPosition
	end

	if not smoothedLookPosition then
		smoothedLookPosition = targetPos
	end

	local cameraAlpha = 1 - math.exp(-LockOnConfig.CameraSmoothness * 60 * dt)

	smoothedCameraPosition = smoothedCameraPosition:Lerp(desiredCameraPosition, cameraAlpha)
	smoothedLookPosition = smoothedLookPosition:Lerp(targetPos, cameraAlpha)

	camera.CFrame = CFrame.lookAt(smoothedCameraPosition, smoothedLookPosition)

	if LockOnConfig.RotateCharacterToTarget then
		local goal = CFrame.lookAt(rootPos, rootPos + flatDirection)
		humanoidRootPart.CFrame = humanoidRootPart.CFrame:Lerp(goal, LockOnConfig.RotationSmoothness)
	end

	if reticleImage then
		if LockOnConfig.ReticleRotates then
			reticleImage.Rotation = (reticleImage.Rotation + LockOnConfig.ReticleRotationSpeed * dt) % 360
		end

		if LockOnConfig.ReticlePulse then
			local pulse = 1 + math.sin(os.clock() * LockOnConfig.ReticlePulseSpeed) * LockOnConfig.ReticlePulseAmount
			reticleImage.Size = UDim2.fromScale(pulse, pulse)
		else
			reticleImage.Size = UDim2.fromScale(1, 1)
		end
	end

	camera.FieldOfView = camera.FieldOfView
		+ (LockOnConfig.LockedFov - camera.FieldOfView) * LockOnConfig.FovSmoothness

	updateThreatArrows()
end

local function lock(): ()
	local target = findBestTarget()
	if not target or not humanoid then
		return
	end

	if not savedCameraType then
		savedCameraType = camera.CameraType
	end

	locked = true
	camera.CameraType = Enum.CameraType.Scriptable

	-- Refresh shift-lock first -- while un-applying it forces AutoRotate back to true, and our
	-- own AutoRotate setting below (needed for RotateCharacterToTarget) must be the last word.
	if shiftLockController then
		shiftLockController:Refresh()
	end

	humanoid.AutoRotate = not LockOnConfig.RotateCharacterToTarget

	setCurrentTarget(target)
	gatherTargets()
end

local function setupInput(): ()
	safeDisconnect(inputConnection)

	inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then
			return
		end

		if input.KeyCode == LockOnConfig.LockKey then
			if locked then
				LockOnController:Unlock()
			else
				lock()
			end
			return
		end

		if locked then
			if input.KeyCode == LockOnConfig.SwitchTargetKey
				or input.UserInputType == LockOnConfig.SwitchTargetMouse
			then
				switchTarget(1)
			end
		end
	end)
end

local function setupCharacter(newCharacter: Model): ()
	local newHumanoid = newCharacter:WaitForChild("Humanoid") :: Humanoid
	if newHumanoid.RigType ~= Enum.HumanoidRigType.R6 then
		-- RigTypeService swaps this transient character out for a fresh R6 model and refires
		-- CharacterAdded -- skip it here to avoid binding to a character that's about to be
		-- destroyed (its RootPart/PrimaryPart may not even be set up yet).
		return
	end

	LockOnController:Unlock()

	character = newCharacter
	humanoid = newHumanoid
	humanoidRootPart = character:WaitForChild("HumanoidRootPart") :: BasePart

	camera = Workspace.CurrentCamera
	camera.FieldOfView = LockOnConfig.DefaultFov

	createScreenGui()
	clearThreatArrows()
	resetCameraSmoothing()

	safeDisconnect(deathConnection)
	deathConnection = humanoid.Died:Connect(function()
		LockOnController:Unlock()
	end)

	setupInput()
end

function LockOnController:IsLocked(): boolean
	return locked
end

function LockOnController:GetCurrentTarget(): BasePart?
	return currentTarget
end

function LockOnController:GetAimDirection(): Vector3?
	if not locked or not currentTarget or not isValidTarget(currentTarget) or not humanoidRootPart then
		return nil
	end

	-- The arrow is spawned and flies from the player's root position on the server (see
	-- BowService.onShoot), not from the camera -- which while locked on sits well off to the
	-- side/back/above the player for the over-the-shoulder framing. Aiming from the camera's
	-- position would compute a direction that visibly diverges from the target once applied from
	-- the player's actual launch point, worse the closer the target is.
	local origin = humanoidRootPart.Position
	local targetPos = getTargetPoint(currentTarget)
	local direction = targetPos - origin

	if direction.Magnitude < 0.001 then
		return nil
	end

	return direction.Unit
end

function LockOnController:KnitStart()
	shiftLockController = Knit.GetController("ShiftLockController")

	if player.Character then
		setupCharacter(player.Character)
	end
	player.CharacterAdded:Connect(setupCharacter)

	Packets.EquipState.OnClientEvent:Connect(function(isEquipped: boolean)
		if not isEquipped then
			LockOnController:Unlock()
		end
	end)

	RunService:BindToRenderStep("LockOnCamera", Enum.RenderPriority.Camera.Value, updateCamera)
end

function LockOnController:KnitInit() end

return LockOnController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="164">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local RunConfig = require(Shared.RunConfig)
local Packets = require(Shared.Packets)

local MovementLocked = ReplicatedStorage.MovementLocked

local MovementController = Knit.CreateController({
	Name = "MovementController",
})

local player = Players.LocalPlayer
local humanoid: Humanoid? = nil
local animator: Animator? = nil
local camera: Camera? = nil
local mobileGui: ScreenGui? = nil
local idleTrack: AnimationTrack? = nil
local walkTrack: AnimationTrack? = nil
local runTrack: AnimationTrack? = nil
local sprintTrack: AnimationTrack? = nil
local walkEntry: typeof(RunConfig.BowWalk)? = nil
local isMovementLocked = false
local bowEquipped = false
local sprintTimerThread: thread? = nil

local function loadTrack(entry: typeof(RunConfig.BowWalk), animationName: string): AnimationTrack
	local animation = Instance.new("Animation")
	animation.Name = animationName
	animation.AnimationId = entry.Id

	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action
	track.Looped = entry.Looped
	return track
end

-- Idle/Walk/Run are only ever loaded while the bow is equipped -- unequipped, none of them exist
-- at all, so Roblox's own default Animate script drives walk/run/idle exactly like a fresh
-- character (matching the request to keep stock Roblox animations when not holding the bow).
local function reloadMovementTracks(): ()
	-- AnimationTrack:Destroy() doesn't reliably stop a track that's actively playing -- without
	-- an explicit Stop() first, the animation can keep looping on the Animator even after the
	-- Lua-side track object is gone (observed: dropping the bow left the Bow Idle/Walk/Run
	-- animation stuck playing forever, especially if it happened mid-run).
	if idleTrack then
		idleTrack:Stop(0)
		idleTrack:Destroy()
		idleTrack = nil
	end
	if walkTrack then
		walkTrack:Stop(0)
		walkTrack:Destroy()
		walkTrack = nil
	end
	if runTrack then
		runTrack:Stop(0)
		runTrack:Destroy()
		runTrack = nil
	end

	if bowEquipped then
		walkEntry = RunConfig.BowWalk
		walkTrack = loadTrack(RunConfig.BowWalk, "WalkAnimation")
		runTrack = loadTrack(RunConfig.BowRun, "RunAnimation")
		idleTrack = loadTrack(RunConfig.BowIdle, "IdleAnimation")
	else
		walkEntry = nil
	end

	-- Fully reset movement state on any equip change so switching mid-run/mid-sprint doesn't
	-- leave a stale Running/Sprinting flag, WalkSpeed, or camera FOV behind from the animation
	-- set that just got replaced.
	RunConfig.Running = false
	RunConfig.Sprinting = false
	humanoid.WalkSpeed = RunConfig.WalkSpeed
	if camera then
		camera.FieldOfView = RunConfig.WalkFov
	end
	if sprintTimerThread then
		task.cancel(sprintTimerThread)
		sprintTimerThread = nil
	end
end

local function Walk()
	RunConfig.Running = false
	RunConfig.Sprinting = false

	TweenService
		:Create(
			humanoid,
			TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ WalkSpeed = RunConfig.WalkSpeed }
		)
		:Play()
	TweenService
		:Create(
			camera,
			TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{ FieldOfView = RunConfig.WalkFov }
		)
		:Play()

	if runTrack then
		runTrack:Stop()
	end
	if sprintTrack then
		sprintTrack:Stop()
	end

	if sprintTimerThread then
		task.cancel(sprintTimerThread)
		sprintTimerThread = nil
	end
end

local function Sprint()
	if RunConfig.Walking and RunConfig.Running and RunConfig.CanSprint then
		RunConfig.Sprinting = true

		TweenService
			:Create(
				humanoid,
				TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ WalkSpeed = RunConfig.SprintSpeed }
			)
			:Play()
		TweenService
			:Create(
				camera,
				TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ FieldOfView = RunConfig.SprintFov }
			)
			:Play()
		-- sprintTrack:Play() -- temporarily disabled to test Bow Run animation in isolation
	end
end

local function Run()
	if isMovementLocked then
		return
	end

	if RunConfig.Walking and RunConfig.CanRun then
		RunConfig.Running = true

		TweenService
			:Create(
				humanoid,
				TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ WalkSpeed = RunConfig.RunSpeed }
			)
			:Play()
		TweenService
			:Create(
				camera,
				TweenInfo.new(RunConfig.TransitionSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
				{ FieldOfView = RunConfig.RunFov }
			)
			:Play()
		if runTrack then
			runTrack:Play()
		end
		if walkTrack then
			walkTrack:Stop()
		end

		sprintTimerThread = task.delay(RunConfig.SprintTransitionSpeed, function()
			if RunConfig.Running then
				Sprint()
			end
		end)
	end
end

local function onCharacterAdded(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	animator = humanoid:WaitForChild("Animator") :: Animator
	camera = workspace.CurrentCamera

	-- RigTypeService replaces player.Character with a freshly built R6 model (rather than the
	-- character spawning through the normal engine pipeline), so the camera doesn't automatically
	-- follow it -- it's left pointed at the previous (now-destroyed) character's Humanoid.
	camera.CameraSubject = humanoid
	camera.CameraType = Enum.CameraType.Custom

	if sprintTrack then
		sprintTrack:Destroy()
	end
	sprintTrack = loadTrack(RunConfig.Sprint, "SprintAnimation")

	bowEquipped = false
	reloadMovementTracks()
end

local function onEquipStateChanged(isEquipped: boolean): ()
	-- Tool Equipped/Unequipped can fire more than once for a single logical equip/drop action,
	-- so EquipState sometimes arrives repeated with the same value -- reloading every time would
	-- stack duplicate Idle/Walk/Run tracks on top of each other instead of replacing them.
	if bowEquipped == isEquipped then
		return
	end

	bowEquipped = isEquipped
	if humanoid and animator then
		reloadMovementTracks()
	end
end

local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
	if gameProcessedEvent then
		return
	end

	if input.KeyCode == RunConfig.RunKey then
		Run()
	end
end

local function onInputEnded(input: InputObject)
	if input.KeyCode == RunConfig.RunKey then
		Walk()
	end
end

function MovementController:KnitStart()
	mobileGui = player:WaitForChild("PlayerGui"):WaitForChild("MobileGui") :: ScreenGui

	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Packets.EquipState.OnClientEvent:Connect(onEquipStateChanged)

	mobileGui.RunButton.MouseButton1Down:Connect(Run)
	mobileGui.RunButton.MouseButton1Up:Connect(Walk)

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.MouseEnabled then
		mobileGui.Enabled = true
	end

	RunService.RenderStepped:Connect(function()
		if isMovementLocked or not humanoid then
			return
		end

		if humanoid.MoveDirection.Magnitude > 0 then
			RunConfig.Walking = true
			if idleTrack then
				idleTrack:Stop()
			end

			-- Explicitly override the core walk/run blend so normal walking always reads as a
			-- clean walk gait instead of whatever mix the default Animate script picks -- only
			-- while the bow is equipped; unequipped, walkTrack is nil and Roblox's default
			-- Animate script handles it on its own.
			if walkTrack and not RunConfig.Running and not walkTrack.IsPlaying then
				walkTrack:Play()
				walkTrack:AdjustSpeed(walkEntry and walkEntry.Speed or 1)
			end
		else
			RunConfig.Walking = false
			if walkTrack then
				walkTrack:Stop()
			end

			if RunConfig.Running then
				Walk()
			end

			if idleTrack and not idleTrack.IsPlaying then
				idleTrack:Play()
			end
		end
	end)

	-- Fired by AnimationController while an Anchor = true emote (like Meditate) is active, so we
	-- don't play walk/run over top of the emote's pose while the character is held in place.
	MovementLocked.Event:Connect(function(locked: boolean)
		isMovementLocked = locked
		if locked then
			if runTrack then
				runTrack:Stop()
			end
			if sprintTrack then
				sprintTrack:Stop()
			end
			if walkTrack then
				walkTrack:Stop()
			end
			if idleTrack then
				idleTrack:Stop()
			end
		end
	end)
end

function MovementController:KnitInit() end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="165">
            <Properties>
              <string name="Name">RagdollController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local RagdollController = Knit.CreateController({
	Name = "RagdollController",
})

local Settings = {
	CleanupTime = 4, -- How long the ragdoll body sticks around after death.
}

-- Limb socket data relative to the Torso, R6-specific (Right Arm/Left Arm/Right Leg/Left Leg).
local AttachmentData = {
	RA = { "Right Arm", CFrame.new(0, 0.5, 0), CFrame.new(1.5, 0.5, 0) },
	LA = { "Left Arm", CFrame.new(0, 0.5, 0), CFrame.new(-1.5, 0.5, 0) },
	RL = { "Right Leg", CFrame.new(0, 0.5, 0), CFrame.new(0.5, -1.5, 0) },
	LL = { "Left Leg", CFrame.new(0, 0.5, 0), CFrame.new(-0.5, -1.5, 0) },
}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function createCollisionPart(): BasePart
	local part = Instance.new("Part")
	part.Name = "CP"
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Size = Vector3.new(1, 1.5, 1)
	part.Transparency = 1
	return part
end

local function onDied(character: Model): ()
	character.Archivable = true
	local ragdoll = character:Clone()
	character.Archivable = false

	-- Strip the real character down to just the Humanoid -- the clone becomes the visible corpse.
	for _, obj in character:GetChildren() do
		if not obj:IsA("Humanoid") then
			obj:Destroy()
		end
	end

	-- Remove anything that would keep the clone rigid or scripted: ForceFields, the root part's
	-- joints, Motor6Ds/Welds (except the head attachment), scripts, particles.
	local function scan(instances: { Instance })
		for _, inst in instances do
			scan(inst:GetChildren())
			if
				inst:IsA("ForceField")
				or inst.Name == "HumanoidRootPart"
				or ((inst:IsA("Weld") or inst:IsA("Motor6D")) and inst.Name ~= "HeadWeld" and inst.Name ~= "AttachementWeld")
			then
				inst:Destroy()
			end
		end
	end
	scan(ragdoll:GetChildren())

	local function scanClean(inst: Instance)
		for _, obj in inst:GetChildren() do
			scanClean(obj)
			if
				obj:IsA("Script")
				or obj:IsA("LocalScript")
				or ((obj:IsA("Weld") or obj:IsA("Motor6D")) and obj.Name ~= "AttachementWeld")
				or obj:IsA("ForceField")
				or obj:IsA("ParticleEmitter")
			then
				obj:Destroy()
			elseif obj:IsA("BasePart") then
				obj.AssemblyLinearVelocity = Vector3.zero
				obj.AssemblyAngularVelocity = Vector3.zero
				if obj.Parent and obj.Parent:IsA("Accessory") then
					obj.CanCollide = false
				end
			end
		end
	end
	scanClean(ragdoll)

	local ragdollHumanoid = ragdoll:FindFirstChildOfClass("Humanoid")
	if not ragdollHumanoid then
		ragdoll:Destroy()
		return
	end
	ragdollHumanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	ragdollHumanoid.PlatformStand = true
	ragdollHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	ragdollHumanoid.Name = "RagdollHumanoid"

	local torso = ragdoll:FindFirstChild("Torso") :: BasePart?
	if torso then
		torso.AssemblyLinearVelocity = Vector3.new(math.random(), 0.0000001, math.random()).Unit * 5
			+ Vector3.new(0, 0.15, 0)

		local head = ragdoll:FindFirstChild("Head") :: BasePart?
		if head then
			camera.CameraSubject = head

			local headWeld = Instance.new("Weld")
			headWeld.Part0 = torso
			headWeld.Part1 = head
			headWeld.C0 = CFrame.new(0, 1.5, 0)
			headWeld.Parent = torso
		end

		for tag, data in AttachmentData do
			local limbName, limbOffset, torsoOffset = data[1], data[2], data[3]
			local limb = ragdoll:FindFirstChild(limbName) :: BasePart?
			if limb then
				local limbAttachment = Instance.new("Attachment")
				limbAttachment.Name = tag
				limbAttachment.CFrame = limbOffset
				limbAttachment.Parent = limb

				local torsoAttachment = Instance.new("Attachment")
				torsoAttachment.Name = tag
				torsoAttachment.CFrame = torsoOffset
				torsoAttachment.Parent = torso

				local socket = Instance.new("BallSocketConstraint")
				socket.Name = tag .. "_SOCKET"
				socket.Attachment0 = torsoAttachment
				socket.Attachment1 = limbAttachment
				socket.Radius = 0
				socket.Parent = torso

				limb.CanCollide = false

				local collisionPart = createCollisionPart()
				local weld = Instance.new("Weld")
				weld.C0 = CFrame.new(0, -0.25, 0)
				weld.Part0 = limb
				weld.Part1 = collisionPart
				weld.Parent = collisionPart
				collisionPart.Parent = ragdoll
			end
		end
	end

	ragdoll.Parent = workspace
	Debris:AddItem(ragdoll, Settings.CleanupTime)

	ragdollHumanoid.MaxHealth = 100
	ragdollHumanoid.Health = ragdollHumanoid.MaxHealth
end

local function onCharacterAdded(character: Model): ()
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(function()
		onDied(character)
	end)
end

function RagdollController:KnitStart()
	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
end

function RagdollController:KnitInit() end

return RagdollController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="166">
            <Properties>
              <string name="Name">ShiftLockController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local CursorOverride = require(Shared.CursorOverride)

local ShiftLockController = Knit.CreateController({
	Name = "ShiftLockController",
})

local CAMERA_OFFSET = Vector3.new(1.75, 0, 0)

local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local humanoid: Humanoid? = nil
local rootPart: BasePart? = nil
local applied = false
local forced = false

local lockOnController: any = nil

local function setApplied(isApplied: boolean): ()
	if isApplied == applied then
		return
	end
	applied = isApplied

	if not humanoid then
		return
	end

	if isApplied then
		CursorOverride.Push()
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		humanoid.AutoRotate = false
		humanoid.CameraOffset = CAMERA_OFFSET
	else
		CursorOverride.Pop()
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		humanoid.AutoRotate = true
		humanoid.CameraOffset = Vector3.zero
	end
end

local function applyState(): ()
	local lockOnActive = lockOnController and lockOnController:IsLocked()
	setApplied(forced and not lockOnActive)
end

local function onCharacterAdded(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart
	applied = false
	applyState()
end

-- Shift lock is entirely driven by the bow's equip state -- no manual toggle. Equipping the bow
-- always locks the camera; dropping/unequipping it always frees it, no exceptions.
function ShiftLockController:SetForced(isForced: boolean): ()
	forced = isForced
	applyState()
end

-- Re-applies shift lock after lock-on releases camera control (e.g. bow still equipped).
function ShiftLockController:Refresh(): ()
	applyState()
end

function ShiftLockController:KnitStart()
	lockOnController = Knit.GetController("LockOnController")

	if Player.Character then
		onCharacterAdded(Player.Character)
	end
	Player.CharacterAdded:Connect(onCharacterAdded)

	RunService.RenderStepped:Connect(function()
		if not applied or not rootPart then
			return
		end

		if lockOnController and lockOnController:IsLocked() then
			return
		end

		local lookVector = Camera.CFrame.LookVector
		local flatLook = Vector3.new(lookVector.X, 0, lookVector.Z)
		if flatLook.Magnitude > 0 then
			rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + flatLook)
		end
	end)
end

function ShiftLockController:KnitInit() end

return ShiftLockController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="167">
            <Properties>
              <string name="Name">SmoothCameraController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local clampMagnitude = require(Shared.ClampMagnitude)

local SmoothCameraController = Knit.CreateController({
	Name = "SmoothCameraController",
})

local Settings = {
	HorizontalSpeed = 20,
	VerticalSpeed = 5,
	MaxDistance = 8,
}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local root: BasePart? = nil
local lockOnController: any = nil

local offsetXZ = Vector3.zero
local offsetY = Vector3.zero

local function onCharacterAdded(character: Model): ()
	root = character:WaitForChild("HumanoidRootPart") :: BasePart
end

local function onRenderStep(deltaTime: number): ()
	if not root then
		return
	end

	if lockOnController and lockOnController:IsLocked() then
		return
	end

	-- Offset the camera opposite the character's velocity so it lags behind movement slightly.
	offsetXZ -= Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z) * deltaTime
	offsetY -= Vector3.new(0, root.AssemblyLinearVelocity.Y, 0) * deltaTime

	-- Clamp so fast movement doesn't push the character out of view.
	offsetXZ = clampMagnitude(offsetXZ, Settings.MaxDistance)
	offsetY = clampMagnitude(offsetY, Settings.MaxDistance)

	-- Lerp the offset back to zero so the camera doesn't get left behind permanently.
	offsetXZ = offsetXZ:Lerp(Vector3.zero, math.min(deltaTime * Settings.HorizontalSpeed, 1))
	offsetY = offsetY:Lerp(Vector3.zero, math.min(deltaTime * Settings.VerticalSpeed, 1))

	camera.CFrame += offsetXZ + offsetY
end

function SmoothCameraController:KnitStart()
	lockOnController = Knit.GetController("LockOnController")

	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	-- Runs just after Roblox's own camera update so the lag offset layers on top cleanly.
	RunService:BindToRenderStep("CameraSmoothing", Enum.RenderPriority.Camera.Value + 1, onRenderStep)
end

function SmoothCameraController:KnitInit() end

return SmoothCameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="168">
            <Properties>
              <string name="Name">TopbarMenuController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Icon = require(Packages.TopbarPlus)
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local AnimationCatalog = require(Shared.AnimationCatalog)

local EmoteRequested = ReplicatedStorage.EmoteRequested

local TopbarMenuController = Knit.CreateController({
	Name = "TopbarMenuController",
})

local function buildEmoteDropdownItems(): { any }
	local emoteNames = {}
	for emoteName in AnimationCatalog.Emotes do
		table.insert(emoteNames, emoteName)
	end
	table.sort(emoteNames)

	local items = {}
	for _, emoteName in emoteNames do
		local emote = AnimationCatalog.Emotes[emoteName]
		local item = Icon.new()
			:setName(`Emote_{emoteName}`)
			:setLabel(emoteName)
			:oneClick()
			:bindEvent("selected", function()
				EmoteRequested:Fire(emoteName, emote)
			end)

		table.insert(items, item)
	end

	return items
end

function TopbarMenuController:KnitStart()
	Icon.new()
		:setName("EmoteMenu")
		:setLabel("Emotes")
		:modifyTheme({ { "Dropdown", "MaxIcons", 4 } })
		:modifyChildTheme({ { "Widget", "MinimumWidth", 140 } })
		:setDropdown(buildEmoteDropdownItems())
end

function TopbarMenuController:KnitInit() end

return TopbarMenuController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
