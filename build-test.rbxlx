          <Item class="TextLabel" referent="123">
            <Properties>
              <string name="Name">toolAmount</string>
              <Vector2 name="AnchorPoint">
                <X>1</X>
                <Y>0</Y>
              </Vector2>
              <float name="BackgroundTransparency">1</float>
              <int name="BorderSizePixel">0</int>
              <UDim2 name="Position">
                <XS>0.95</XS>
                <XO>0</XO>
                <YS>0.05</YS>
                <YO>0</YO>
              </UDim2>
              <UDim2 name="Size">
                <XS>0.35</XS>
                <XO>0</XO>
                <YS>0.25</YS>
                <YO>0</YO>
              </UDim2>
              <string name="Text"></string>
              <Color3 name="TextColor3">
                <R>1</R>
                <G>1</G>
