      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">CurrencyFormat</string>
          <string name="Source"><![CDATA[local CurrencyFormat = {}

function CurrencyFormat.format(value: number): string
	local decimalPlaces = 2

	if value < 1000 then
		return tostring(math.floor(value + 0.5))
	end

	local abbreviations = { "", "K", "M", "B", "T" }
	local exponent = math.floor(math.log(math.max(1, math.abs(value)), 1000))
	local suffix = abbreviations[1 + exponent] or ("e+" .. exponent)
	local normalized = math.floor(value * ((10 ^ decimalPlaces) / (1000 ^ exponent))) / (10 ^ decimalPlaces)

	return string.format("%." .. decimalPlaces .. "f%s", normalized, suffix)
end

return CurrencyFormat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="73">
        <Properties>
          <string name="Name">CursorOverride</string>
          <string name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")

-- Reference-counted so multiple systems (bow aiming, shift lock) can request the same
-- locked-camera cursor without one clearing it out from under the other.
local CursorOverride = {}

local ICON = "rbxassetid://9102463858"
local count = 0

function CursorOverride.Push(): ()
	count += 1
	UserInputService.MouseIcon = ICON
end

function CursorOverride.Pop(): ()
	count = math.max(0, count - 1)
	if count == 0 then
		UserInputService.MouseIcon = ""
	end
end

return CursorOverride
]]></string>
