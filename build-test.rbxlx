        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">RigTypeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

-- Forces every character to rebuild as R6 right after spawning, regardless of the player's own
-- avatar type preference. Studio's "Avatar Type" game setting only affects what a fresh
-- Play-Solo session defaults to and isn't reliably scriptable, so this is the actual
-- authoritative switch -- it works the same in Studio and in the published game.
--
-- Humanoid.RigType is read-only and ApplyDescription can't change rig type either (its second
-- argument is AssetTypeVerification, not a rig type) -- the only way to actually get an R6 body
-- is to build a fresh model via CreateHumanoidModelFromDescription and swap it in as the
-- player's Character.
local RigTypeService = Knit.CreateService({
	Name = "RigTypeService",
	Client = {},
})

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		return
	end

	local ok, description = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if not ok or not description then
		return
	end

	local newCharacter = Players:CreateHumanoidModelFromDescription(
		description,
		Enum.HumanoidRigType.R6,
		Enum.AssetTypeVerification.Default
	)
	newCharacter.Name = player.Name
	newCharacter:PivotTo(character:GetPivot())
	newCharacter.Parent = Workspace

	player.Character = newCharacter
	character:Destroy()
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)

	if player.Character then
		onCharacterAdded(player, player.Character)
	end
end

function RigTypeService:KnitStart()
	Players.PlayerAdded:Connect(onPlayerAdded)

	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

function RigTypeService:KnitInit() end

return RigTypeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">SpawnService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local SPAWN_POINT_NAME = "Mystical Spawn Point"
local SPAWN_HEIGHT_OFFSET = 3

local SpawnService = Knit.CreateService({
	Name = "SpawnService",
	Client = {},
})

local function findMysticalSpawn(): Instance?
	return Workspace:FindFirstChild(SPAWN_POINT_NAME)
end

local function getSpawnCFrame(): CFrame?
	local spawnPoint = findMysticalSpawn()
	if not spawnPoint then
		return nil
	end

	local spawnLocation = spawnPoint:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawnLocation then
		local surfaceCFrame = spawnLocation.CFrame * CFrame.new(0, spawnLocation.Size.Y * 0.5, 0)
		return surfaceCFrame * CFrame.new(0, SPAWN_HEIGHT_OFFSET, 0)
	end

	if spawnPoint:IsA("BasePart") then
		return spawnPoint.CFrame + Vector3.new(0, SPAWN_HEIGHT_OFFSET, 0)
	end

	if spawnPoint:IsA("Model") then
		return spawnPoint:GetPivot() + Vector3.new(0, SPAWN_HEIGHT_OFFSET, 0)
	end

	return nil
end

local function configureSpawnLocations()
	local mysticalSpawn = findMysticalSpawn()
	if not mysticalSpawn then
		warn(`[SpawnService] "{SPAWN_POINT_NAME}" was not found in Workspace`)
		return
	end

	local primarySpawn = mysticalSpawn:FindFirstChildWhichIsA("SpawnLocation", true)
	if primarySpawn then
		primarySpawn.Enabled = true
		primarySpawn.Neutral = true
		primarySpawn.AllowTeamChangeOnTouch = false
		primarySpawn.Duration = 0
	end

	for _, instance in Workspace:GetDescendants() do
		if instance:IsA("SpawnLocation") and instance ~= primarySpawn then
			instance.Enabled = false
		end
	end
end

local function moveCharacterToSpawn(character: Model)
	local spawnCFrame = getSpawnCFrame()
	if not spawnCFrame then
		return
	end

	character:PivotTo(spawnCFrame)
end

local function onCharacterAdded(character: Model)
	local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 10)
	if not humanoidRootPart then
		return
	end

	moveCharacterToSpawn(character)
end

local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(onCharacterAdded)

	if player.Character then
		onCharacterAdded(player.Character)
	end
end

function SpawnService:KnitStart()
	configureSpawnLocations()

	Players.PlayerAdded:Connect(onPlayerAdded)

	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

function SpawnService:KnitInit() end

return SpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">ZombieService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local ZombieAI = require(script.Parent.Parent.ZombieAI)
local DestroyService = require(script.Parent.Parent.ZombieAI.DestroyService)

local ZOMBIE_TAG = "Zombie"
local SPAWN_CFRAME = CFrame.new(-10, 3, 10)
local ARMS_LOOP_INTERVAL = 2
local LAST_ATTACKER_ATTRIBUTE = "LastAttackerUserId"

local ZombieService = Knit.CreateService({
	Name = "ZombieService",
	Client = {},
})

local currencyService: any = nil

local function getKillRewardPlayer(zombie: Model): Player?
	local killerUserId = zombie:GetAttribute(LAST_ATTACKER_ATTRIBUTE)
	if typeof(killerUserId) == "number" then
		local player = Players:GetPlayerByUserId(killerUserId)
		if player then
			return player
		end
	end

	local humanoid = zombie:FindFirstChildOfClass("Humanoid")
	local creator = humanoid and humanoid:FindFirstChild("creator")
	if creator and creator:IsA("ObjectValue") and creator.Value and creator.Value:IsA("Player") then
		return creator.Value
	end

	return nil
end

local function playArmsLoop(zombie: Model): ()
	task.spawn(function()
		while zombie.Parent do
			local ok, track = pcall(function()
				return zombie.Humanoid:LoadAnimation(zombie.Animations.Arms)
			end)
			if ok then
				track:Play()
			end
			task.wait(ARMS_LOOP_INTERVAL)
		end
	end)
end

-- Recursively fades and queues every part of the corpse for delayed cleanup, matching the
-- original catalog model's death behavior.
local function queueCorpseCleanup(instance: Instance): ()
	for _, child in instance:GetChildren() do
		queueCorpseCleanup(child)
	end

	local delay = if instance:IsA("BasePart") then math.random(5, 10) else 11
	DestroyService:AddItem(instance, delay)
end

local function spawnZombie(cframe: CFrame): Model
	local template = ServerStorage:FindFirstChild("ZombieTemplate")
	if not template then
		warn("ZombieService: ServerStorage.ZombieTemplate not found -- cannot spawn zombie")
		return nil :: any
	end

	local zombie = template:Clone()
	zombie:PivotTo(cframe)
	CollectionService:AddTag(zombie, ZOMBIE_TAG)
	zombie.Parent = Workspace

	playArmsLoop(zombie)

	local ai = ZombieAI.new(zombie)

	zombie.Humanoid.Died:Connect(function()
		ai.Stop()

		local killer = getKillRewardPlayer(zombie)
		if killer and currencyService then
			currencyService:AwardZombieKill(killer)
		end

		queueCorpseCleanup(zombie)
	end)

	return zombie
end

function ZombieService:KnitStart()
	currencyService = Knit.GetService("CurrencyService")
	spawnZombie(SPAWN_CFRAME)
end

function ZombieService:KnitInit() end

return ZombieService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">ZombieAI</string>
          <string name="Source"><![CDATA[-- Zombie AI: field-of-view + raycast target detection, pathfinding chase, arm-touch melee
-- damage. Ported from Roblox's official "Drooling Zombie" catalog model (ROBLOX_ZombieAI),
-- with requires rewritten from game.ServerStorage.X to sibling modules (script.X).
local CollectionService = game:GetService("CollectionService")

local HumanoidList = require(script.HumanoidList)
local AIUtilities = require(script.AIUtilities)

local ZOMBIE_TAG = "Zombie"

local ZombieAI = {}

ZombieAI.new = function(model: Model)
	local zombie = {}

	-- CONFIGURATION VARIABLES -- read from model.Configurations, falling back to defaults.
	local configTable = model.Configurations
	local configs = {}
	local function loadConfig(configName: string, defaultValue: number)
		local found = configTable:FindFirstChild(configName)
		configs[configName] = if found then found.Value else defaultValue
	end

	loadConfig("AttackRange", 3)
	loadConfig("FieldOfView", 180)
	loadConfig("AggroRange", 200)
	loadConfig("ChanceOfBoredom", 0.5)
	loadConfig("BoredomDuration", 10)
	loadConfig("Damage", 10)
	loadConfig("DamageCooldown", 1)

	local StateMachine = require(script.StateMachine).new()
	local PathLib = require(script.PathfindingLibrary).new()
	local ZombieTarget: Model? = nil
	local ZombieTargetLastLocation: Vector3? = nil

	local lastBored = os.time()

	-- STATE DEFINITIONS

	-- Idle: stays still. Refreshes the boredom timer on entry to allow a later random transition.
	local IdleState = StateMachine.NewState()
	IdleState.Name = "Idle"
	IdleState.Action = function() end
	IdleState.Init = function()
		lastBored = os.time()
	end

	-- Search: wanders to a random nearby empty spot, increasing the chance of spotting a target.
	local SearchState = StateMachine.NewState()
	SearchState.Name = "Search"
	local lastMoved = os.time()
	local searchTarget: Vector3? = nil
	SearchState.Action = function()
		local now = os.time()
		if now - lastMoved > 2 then
			lastMoved = now
			searchTarget = AIUtilities:FindCloseEmptySpace(model)
		end
		if searchTarget then
			PathLib:MoveToTarget(model, searchTarget)
		end
	end
	SearchState.Init = function()
		lastBored = os.time()
	end

	-- Pursue: target spotted, give chase (pathfinding while far, direct MoveTo once close).
	local PursueState = StateMachine.NewState()
	PursueState.Name = "Pursue"
	PursueState.Action = function()
		if ZombieTarget then
			local distance = (model.HumanoidRootPart.Position - ZombieTarget.HumanoidRootPart.Position).Magnitude
			if distance > configs["AttackRange"] + 5 then
				PathLib:MoveToTarget(model, ZombieTarget.HumanoidRootPart.Position)
			else
				model.Humanoid:MoveTo(ZombieTarget.HumanoidRootPart.Position)
			end
		end
	end

	-- Attack: keep closing on the target and replay the attack animation every 3s. Damage itself
	-- is applied via the arm Touched handlers below, not here.
	local AttackState = StateMachine.NewState()
	AttackState.Name = "Attack"
	local lastAttack = os.time()
	local attackTrack = model.Humanoid:LoadAnimation(model.Animations.Attack)
	AttackState.Action = function()
		model.Humanoid:MoveTo(ZombieTarget.HumanoidRootPart.Position)
		local now = os.time()
		if now - lastAttack > 3 then
			lastAttack = now
			attackTrack:Play()
		end
	end

	-- Hunt: lost sight of the target, head to its last known position until bored.
	local HuntState = StateMachine.NewState()
	HuntState.Name = "Hunt"
	HuntState.Action = function()
		if ZombieTargetLastLocation then
			PathLib:MoveToTarget(model, ZombieTargetLastLocation)
		end
	end
	HuntState.Init = function()
		lastBored = os.time() + configs["BoredomDuration"] / 2
	end

	-- CONDITION DEFINITIONS

	-- CanSeeTarget: true (and sets ZombieTarget) if a live, moving humanoid is within AggroRange,
	-- inside the field-of-view wedge, and has clear line of sight. Other zombies are excluded
	-- from being targets but included in the raycast ignore-list.
	local CanSeeTarget = StateMachine.NewCondition()
	CanSeeTarget.Name = "CanSeeTarget"
	CanSeeTarget.Evaluate = function()
		local humanoids = HumanoidList:GetCurrent()
		local zombies = {}
		local characters = {}
		for _, humanoid in humanoids do
			if humanoid and humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart") and humanoid.Health > 0 and humanoid.WalkSpeed > 0 then
				local rootPart = humanoid.Parent.HumanoidRootPart
				local distance = (model.HumanoidRootPart.Position - rootPart.Position).Magnitude
				if distance <= configs["AggroRange"] then
					if CollectionService:HasTag(humanoid.Parent, ZOMBIE_TAG) then
						table.insert(zombies, humanoid.Parent)
					else
						table.insert(characters, humanoid.Parent)
					end
				end
			end
		end

		local target = AIUtilities:GetClosestVisibleTarget(model, characters, zombies, configs["FieldOfView"])
		if target then
			ZombieTarget = target
			return true
		end
		return false
	end
	CanSeeTarget.TransitionState = PursueState

	local TargetDead = StateMachine.NewCondition()
	TargetDead.Name = "TargetDead"
	TargetDead.Evaluate = function()
		if ZombieTarget and ZombieTarget:FindFirstChildOfClass("Humanoid") then
			return ZombieTarget.Humanoid.Health <= 0
		end
		return true
	end
	TargetDead.TransitionState = IdleState

	local lastHealth = model.Humanoid.Health
	local GotDamaged = StateMachine.NewCondition()
	GotDamaged.Name = "GotDamaged"
	GotDamaged.Evaluate = function()
		if lastHealth > model.Humanoid.Health then
			lastHealth = model.Humanoid.Health
			return true
		end
		lastHealth = model.Humanoid.Health
		return false
	end
	GotDamaged.TransitionState = SearchState

	-- GotBored: random state change so idling zombies don't stand still forever.
	local GotBored = StateMachine.NewCondition()
	GotBored.Name = "GotBored"
	GotBored.Evaluate = function()
		local now = os.time()
		if now - lastBored > configs["BoredomDuration"] then
			local roll = math.random()
			if roll < configs["ChanceOfBoredom"] then
				lastBored = now
				GotBored.TransitionState = if GotBored.TransitionState == SearchState then IdleState else SearchState
				return true
			end
		end
		return false
	end
	GotBored.TransitionState = IdleState

	local WithinRange = StateMachine.NewCondition()
	WithinRange.Name = "WithinRange"
	WithinRange.Evaluate = function()
		if ZombieTarget then
			local distance = (model.HumanoidRootPart.Position - ZombieTarget.HumanoidRootPart.Position).Magnitude
			return distance < configs["AttackRange"]
		end
		return false
	end
	WithinRange.TransitionState = AttackState

	local OutsideRange = StateMachine.NewCondition()
	OutsideRange.Name = "OutsideRange"
	OutsideRange.Evaluate = function()
		if ZombieTarget then
			local distance = (model.HumanoidRootPart.Position - ZombieTarget.HumanoidRootPart.Position).Magnitude
			return distance > configs["AttackRange"]
		end
		return false
	end
	OutsideRange.TransitionState = PursueState

	table.insert(IdleState.Conditions, CanSeeTarget)
	table.insert(IdleState.Conditions, GotDamaged)
	table.insert(IdleState.Conditions, GotBored)

	table.insert(SearchState.Conditions, GotBored)
	table.insert(SearchState.Conditions, CanSeeTarget)

	table.insert(PursueState.Conditions, WithinRange)
	table.insert(PursueState.Conditions, TargetDead)

	table.insert(AttackState.Conditions, OutsideRange)
	table.insert(AttackState.Conditions, TargetDead)

	table.insert(HuntState.Conditions, GotBored)
	table.insert(HuntState.Conditions, CanSeeTarget)

	-- Arm-touch melee damage, independent of the Attack state's own animation-replay cooldown.
	local canHit = true
	local lastHit = os.time()
	local function handleHit(other: BasePart)
		if canHit then
			local enemy = other.Parent
			if enemy and not CollectionService:HasTag(enemy, ZOMBIE_TAG) and enemy:FindFirstChildOfClass("Humanoid") then
				local enemyHumanoid = enemy.Humanoid :: Humanoid
				if enemyHumanoid.WalkSpeed > 0 then
					enemyHumanoid.Health -= configs["Damage"]
					canHit = false
				end
			end
		else
			local now = os.time()
			if now - lastHit > configs["DamageCooldown"] then
				lastHit = now
				canHit = true
			end
		end
	end
	local leftArm = model:FindFirstChild("Left Arm") :: BasePart
	local rightArm = model:FindFirstChild("Right Arm") :: BasePart
	leftArm.Touched:Connect(handleHit)
	rightArm.Touched:Connect(handleHit)

	-- Zombie-zombie repulsion so they don't stack on top of each other while chasing the same
	-- target, applied through the RepulsionForce (BodyForce) baked into the template model.
	task.spawn(function()
		while true do
			task.wait()
			local humanoids = HumanoidList:GetCurrent()
			local nearbyPositions = {}
			for _, humanoid in humanoids do
				if humanoid and humanoid ~= model.Humanoid and humanoid.Parent and humanoid.Parent:FindFirstChild("HumanoidRootPart") then
					local rootPart = humanoid.Parent.HumanoidRootPart
					local distance = (model.HumanoidRootPart.Position - rootPart.Position).Magnitude
					if distance <= 2.5 then
						table.insert(nearbyPositions, rootPart.Position)
					end
				end
			end
			model.HumanoidRootPart.RepulsionForce.force = AIUtilities:GetRepulsionVector(model.HumanoidRootPart.Position, nearbyPositions)

			local debug = model.Configurations:FindFirstChild("Debug")
			local billboard = model:FindFirstChild("BillboardGui")
			if billboard then
				local label = billboard:FindFirstChild("TextLabel") :: TextLabel?
				if label then
					local isDebug = debug ~= nil and (debug :: BoolValue).Value
					label.Visible = isDebug
					if isDebug and StateMachine.CurrentState then
						label.Text = StateMachine.CurrentState.Name
					end
				end
			end
		end
	end)

	StateMachine.SwitchState(IdleState)

	zombie.Stop = function()
		StateMachine.SwitchState(nil)
	end

	return zombie
end

return ZombieAI
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">AIUtilities</string>
            <string name="Source"><![CDATA[-- Stateless AI utility functions. Ported verbatim from Roblox's official "Drooling Zombie"
-- catalog model (ROBLOX_AIUtilities).
local utility = {}

function utility:WideRayCast(start: Vector3, target: Vector3, offset: number, ignoreList: { Instance }): { BasePart }
	local parts = {}

	local ray = Ray.new(start, target - start)
	local part = game.Workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
	if part then
		table.insert(parts, part)
	end

	local offsetVector = offset * (target - start):Cross(Vector3.FromNormalId(Enum.NormalId.Top)).Unit
	local ray2 = Ray.new(start + offsetVector, target - start + offsetVector)
	local part2 = game.Workspace:FindPartOnRayWithIgnoreList(ray2, ignoreList)
	if part2 then
		table.insert(parts, part2)
	end

	local ray3 = Ray.new(start - offsetVector, target - start - offsetVector)
	local part3 = game.Workspace:FindPartOnRayWithIgnoreList(ray3, ignoreList)
	if part3 then
		table.insert(parts, part3)
	end

	return parts
end

local maxForce = 15

function utility:GetRepulsionVector(unitPosition: Vector3, otherUnitsPositions: { Vector3 }): Vector3
	local repulsionVector = Vector3.zero
	for _, other in otherUnitsPositions do
		local fromOther = unitPosition - other
		fromOther = fromOther.Unit * 1000 / ((fromOther.Magnitude + 1) ^ 2)
		repulsionVector += fromOther
	end
	return repulsionVector * maxForce
end

function utility:GetClosestVisibleTarget(npcModel: Model, characters: { Model }, ignoreList: { Instance }, fieldOfView: number): Model?
	local closestTarget = nil
	local closestDistance = math.huge
	for _, character in characters do
		local toTarget = character.HumanoidRootPart.Position - npcModel.HumanoidRootPart.Position
		local toTargetWedge = toTarget * Vector3.new(1, 0, 1)
		local angle = math.acos(toTargetWedge:Dot(npcModel.HumanoidRootPart.CFrame.LookVector) / toTargetWedge.Magnitude)
		if math.deg(angle) < fieldOfView then
			local targetRay = Ray.new(npcModel.HumanoidRootPart.Position, toTarget)
			local part = game.Workspace:FindPartOnRayWithIgnoreList(targetRay, ignoreList)
			if part and part.Parent == character then
				if toTarget.Magnitude < closestDistance then
					closestTarget = character
					closestDistance = toTarget.Magnitude
				end
			end
		end
	end
	return closestTarget
end

local function isSpaceEmpty(position: Vector3): boolean
	local region = Region3.new(position - Vector3.new(2, 2, 2), position + Vector3.new(2, 2, 2))
	return game.Workspace:IsRegion3Empty(region)
end

function utility:FindCloseEmptySpace(model: Model): Vector3?
	local count = 0
	repeat
		local xoff = math.random(5, 10) * (if math.random() > 0.5 then -1 else 1)
		local zoff = math.random(5, 10) * (if math.random() > 0.5 then -1 else 1)

		local targetPos = Vector3.new(
			model.HumanoidRootPart.Position.X + xoff,
			model.HumanoidRootPart.Position.Y,
			model.HumanoidRootPart.Position.Z + zoff
		)
		if isSpaceEmpty(targetPos) then
			return targetPos
		end

		targetPos += Vector3.new(0, 4, 0)
		if isSpaceEmpty(targetPos) then
			return targetPos
		end

		count += 1
	until count > 10
	return nil
end

return utility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">DestroyService</string>
            <string name="Source"><![CDATA[-- Delayed-destroy queue with a fade-out effect for Parts in their last second. Ported verbatim
-- from Roblox's official "Drooling Zombie" catalog model (ROBLOX_DestroyService).
local destroyService = {}

local destroyQueue: { { object: Instance, destroyTime: number } } = {}

function destroyService:AddItem(theObject: Instance, delay: number): ()
	local destroyObject = { object = theObject, destroyTime = os.time() + delay }
	for i, storedObject in destroyQueue do
		if storedObject.destroyTime > destroyObject.destroyTime then
			table.insert(destroyQueue, i, destroyObject)
			return
		end
	end
	table.insert(destroyQueue, destroyObject)
end

task.spawn(function()
	while true do
		local now = os.time()
		for _, storedObject in destroyQueue do
			if now >= storedObject.destroyTime then
				table.remove(destroyQueue, 1)
				if storedObject.object then
					storedObject.object:Destroy()
				end
			elseif now >= storedObject.destroyTime - 1 then
				if storedObject.object and storedObject.object:IsA("BasePart") then
					storedObject.object.Transparency += 1 / 30
				end
			else
				break
			end
		end
		task.wait()
	end
end)

return destroyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">HumanoidList</string>
            <string name="Source"><![CDATA[-- Naive full-workspace humanoid scan, refreshed every 3 seconds. Ported verbatim from Roblox's
-- official "Drooling Zombie" catalog model (ROBLOX_HumanoidList).
local humanoidList = {}
local storage = {}

function humanoidList:GetCurrent()
	return storage
end

local function findHumanoids(object: Instance, list: { Humanoid })
	if object then
		if object:IsA("Humanoid") then
			table.insert(list, object)
		end

		for _, child in object:GetChildren() do
			findHumanoids(child, list)
		end
	end
end

task.spawn(function()
	while true do
		local newStorage = {}
		findHumanoids(game.Workspace, newStorage)
		storage = newStorage
		task.wait(3)
	end
end)

return humanoidList
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">PathfindingLibrary</string>
            <string name="Source"><![CDATA[-- Pathfinding wrapper with target-change throttling. Ported verbatim from Roblox's official
-- "Drooling Zombie" catalog model (ROBLOX_PathfindingLibrary).
local PathfindingService = game:GetService("PathfindingService")
PathfindingService.EmptyCutoff = 0.3

local TargetOffsetMax = 10
local JumpThreshold = 1.5
local NextPointThreshold = 4

local PathfindingUtility = {}

function PathfindingUtility.new()
	local this = {}

	local lastTargetPos = Vector3.new(math.huge, math.huge, math.huge)
	local path: Path? = nil
	local currentPointIndex = 1

	function this:MoveToTarget(character: Model, target: Vector3): ()
		local targetOffset = (lastTargetPos - target).Magnitude
		if targetOffset > TargetOffsetMax then
			local startPoint = character.HumanoidRootPart.Position
			local humanoidState = character.Humanoid:GetState()
			if humanoidState == Enum.HumanoidStateType.Jumping or humanoidState == Enum.HumanoidStateType.Freefall then
				local ray = Ray.new(character.HumanoidRootPart.Position, Vector3.new(0, -100, 0))
				local hitPart, hitPoint = game.Workspace:FindPartOnRay(ray, character)
				if hitPart then
					startPoint = hitPoint
				end
			end

			local newTarget = target
			local ray = Ray.new(target + Vector3.new(0, -3, 0), Vector3.new(0, -100, 0))
			local hitPart, hitPoint = game.Workspace:FindPartOnRay(ray, character)
			if hitPart and (hitPoint - target).Magnitude > 4 then
				newTarget = newTarget * Vector3.new(1, 0, 1) + Vector3.new(0, 3, 0)
			end

			path = PathfindingService:ComputeSmoothPathAsync(startPoint, newTarget, 500)
			currentPointIndex = 1
			lastTargetPos = target
		end

		if path then
			local points = path:GetPointCoordinates()
			if currentPointIndex < #points then
				local currentPoint = points[currentPointIndex]
				local distance = (character.HumanoidRootPart.Position - currentPoint).Magnitude
				if distance < NextPointThreshold then
					currentPointIndex += 1
				end

				character.Humanoid:MoveTo(points[currentPointIndex])
				if points[currentPointIndex].Y - character.HumanoidRootPart.Position.Y > JumpThreshold then
					character.Humanoid.Jump = true
				end
			else
				character.Humanoid:MoveTo(target)
			end
		end
	end

	return this
end

return PathfindingUtility
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">StateMachine</string>
            <string name="Source"><![CDATA[-- Generic, zombie-agnostic state machine. Ported verbatim from Roblox's official "Drooling
-- Zombie" catalog model (ROBLOX_StateMachine) -- states/conditions/transitions are entirely
-- built by the caller (see init.luau), this module has no zombie-specific logic.
local machine = {}

machine.new = function()
	local StateMachine = {}

	StateMachine.WaitTime = 0.2
	StateMachine.CurrentState = nil
	StateMachine.SwitchState = function(newState)
		if StateMachine.CurrentState then
			StateMachine.CurrentState.Stop()
		end
		StateMachine.CurrentState = newState
		if newState then
			newState.Start()
		end
	end

	StateMachine.NewState = function()
		local state = {}
		state.Name = ""
		state.Conditions = {}
		state.isRunning = false
		state.Action = function() end
		state.Run = function()
			state.isRunning = true
			while state.isRunning do
				for _, condition in state.Conditions do
					if condition.Evaluate() then
						StateMachine.SwitchState(condition.TransitionState)
						return
					end
				end

				state.Action()
				task.wait(StateMachine.WaitTime)
			end
		end
		state.Init = function() end
		state.Start = function()
			state.Init()
			task.spawn(state.Run)
		end
		state.Stop = function()
			state.isRunning = false
		end
		return state
	end

	StateMachine.NewCondition = function()
		local condition = {}
		condition.Name = ""
		condition.Evaluate = function()
			return false
		end
		condition.TransitionState = {}
		return condition
	end

	return StateMachine
end

return machine
]]></string>
          </Properties>
        </Item>
