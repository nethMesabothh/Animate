  <Item class="StarterPlayer" referent="152">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="153">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="154">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

for _, module in script.Controllers:GetChildren() do
	if module:IsA("ModuleScript") then
		require(module)
	end
end

Knit.Start():catch(warn)
]]></string>
        </Properties>
        <Item class="Folder" referent="155">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="156">
            <Properties>
              <string name="Name">AnimationController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local AnimationCatalog = require(Shared.AnimationCatalog)

local EmoteRequested = ReplicatedStorage.EmoteRequested
local MovementLocked = ReplicatedStorage.MovementLocked
local VfxFolder = ReplicatedStorage:WaitForChild("VFX")

local MEDITATE_ANIMATION = AnimationCatalog.Emotes.Meditate

local AnimationController = Knit.CreateController({
	Name = "AnimationController",
})

local player = Players.LocalPlayer
local humanoid: Humanoid? = nil
local animator: Animator? = nil
local rootPart: BasePart? = nil
local activeEmoteTrack: AnimationTrack? = nil
local activeEmoteName: string? = nil
local anchoredRootPart: BasePart? = nil
local activeVfx: BasePart? = nil

local function onCharacterAdded(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	animator = humanoid:WaitForChild("Animator") :: Animator
	rootPart = character:WaitForChild("HumanoidRootPart") :: BasePart
	activeEmoteTrack = nil
	activeEmoteName = nil
	anchoredRootPart = nil
	-- The old character (and anything welded to it, including any active VFX clone) is
	-- destroyed by Roblox on respawn, so this reference would otherwise go stale.
	activeVfx = nil
end

local function spawnVfx(vfxName: string)
	local template = VfxFolder:FindFirstChild(vfxName)
	if not template or not rootPart then
		return
	end

	local vfx = template:Clone() :: BasePart
	vfx.CFrame = rootPart.CFrame
	vfx.Anchored = false
	vfx.CanCollide = false
	vfx.Massless = true
	vfx.Parent = rootPart.Parent

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = rootPart
	weld.Part1 = vfx
	weld.Parent = vfx

	local enableAttachment = vfx:FindFirstChild("Enable")
	local sound = enableAttachment and enableAttachment:FindFirstChildOfClass("Sound")
	if sound then
		sound:Play()
	end

	activeVfx = vfx

	-- "Enable" emitters are the activation burst; switch them off after a moment so they don't
	-- keep firing for the whole meditate duration. "Emit" emitters are the sustained aura and
	-- stay on until the emote ends (stopVfx below).
	task.delay(1, function()
		if activeVfx ~= vfx or not enableAttachment then
			return
		end
		for _, emitter in enableAttachment:GetChildren() do
			if emitter:IsA("ParticleEmitter") then
				emitter.Enabled = false
			end
		end
	end)
end

local function stopVfx()
	if not activeVfx then
		return
	end
	local vfx = activeVfx
	activeVfx = nil

	local emitAttachment = vfx:FindFirstChild("Emit")
	if emitAttachment then
		for _, emitter in emitAttachment:GetChildren() do
			if emitter:IsA("ParticleEmitter") then
				emitter.Enabled = false
			end
		end
	end

	-- Let already-emitted particles fade out naturally instead of popping the whole effect away.
	task.delay(2, function()
		vfx:Destroy()
	end)
end

local function stopActiveEmote()
	if activeEmoteTrack then
		activeEmoteTrack:Stop()
		activeEmoteTrack = nil
	end
	activeEmoteName = nil
	stopVfx()

	if anchoredRootPart then
		anchoredRootPart.Anchored = false
		anchoredRootPart = nil

		-- Hand animation control back to Roblox's default Animate script.
		if humanoid then
			humanoid.PlatformStand = false
		end

		-- Tell MovementController/DoubleJumpController it's safe to resume playing their own
		-- movement animations again.
		MovementLocked:Fire(false)
	end
end

local function isAirborne(): boolean
	if not humanoid then
		return false
	end
	local state = humanoid:GetState()
	return state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
end

local function playEmote(emoteName: string, emote: typeof(MEDITATE_ANIMATION))
	if not animator then
		return
	end

	-- Anchor = true emotes freeze you in place -- don't allow starting one mid-air, or you'd
	-- end up floating/frozen wherever you happened to be when the jump was interrupted.
	if emote.Anchor and activeEmoteName ~= emoteName and isAirborne() then
		return
	end

	-- Requesting the same emote again toggles it off instead of restarting it -- important for
	-- Anchor = true emotes, since that's the only way to release the anchor and move again.
	if activeEmoteName == emoteName then
		stopActiveEmote()
		return
	end

	stopActiveEmote()

	local animation = Instance.new("Animation")
	animation.Name = emoteName
	animation.AnimationId = emote.Id

	local track = animator:LoadAnimation(animation)
	track.Looped = emote.Looped
	track.Priority = Enum.AnimationPriority.Action
	track:Play()
	activeEmoteTrack = track
	activeEmoteName = emoteName

	if emote.Vfx then
		spawnVfx(emote.Vfx)
	end

	if emote.Anchor and rootPart then
		anchoredRootPart = rootPart
		anchoredRootPart.Anchored = true

		-- Roblox's default Animate script plays its own Jumping/Freefall poses at Core
		-- priority -- the highest tier, above even our Action2 jump animations -- so it would
		-- otherwise visually mask this emote entirely if triggered while airborne. PlatformStand
		-- hands animation control over to us completely until it's turned back off below.
		if humanoid then
			humanoid.PlatformStand = true
		end

		-- Tell other movement controllers to stop playing walk/run/jump animations (and stop
		-- reacting to movement/jump input) while this pose is held.
		MovementLocked:Fire(true)
	end
end

local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
	if gameProcessedEvent then
		return
	end

	if input.KeyCode ~= Enum.KeyCode.M then
		return
	end

	playEmote("Meditate", MEDITATE_ANIMATION)
end

function AnimationController:KnitStart()
	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	EmoteRequested.Event:Connect(function(emoteName: string, emote: typeof(MEDITATE_ANIMATION))
		playEmote(emoteName, emote)
	end)
end

function AnimationController:KnitInit() end

return AnimationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="157">
            <Properties>
              <string name="Name">BowController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local Flash = require(Shared.Flash)
local Packets = require(Shared.Packets)
local CursorOverride = require(Shared.CursorOverride)

local Assets = ReplicatedStorage.Assets
local Animations = Assets.Animations

local MovementLocked = ReplicatedStorage.MovementLocked

local BowController = Knit.CreateController({
	Name = "BowController",
})

local Player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local Settings = {
	HoldThreshold = 0.2,
	FastHoldThreshold = 0.2,
	FastShotCooldown = 1,

	AimFOV = 40,
	DefaultFOV = 70,
	FOVTweenTime = 0.3,

	AimWalkSpeed = 1,
}

local State = {
	Aiming = false,
	Holding = false,
	FastAiming = false,
	FastShotFired = false,

	MouseDownTime = 0,
	FastMouseDownTime = 0,
	LastFastShotTime = 0,

	OriginalWalkSpeed = 16,
	CurrentFOVTween = nil :: Tween?,
}

local Humanoid: Humanoid? = nil
local Sounds: { [string]: Sound } = nil
local Tracks: { [string]: AnimationTrack } = nil
local Equipped = false
local lockOnController: any = nil

local function getShootDirection(): Vector3
	local aimDirection = lockOnController and lockOnController:GetAimDirection()
	if aimDirection then
		return aimDirection
	end

	return Camera.CFrame.LookVector
end

local function LoadAnimation(animation: Animation): AnimationTrack
	local animator = Humanoid:FindFirstChildOfClass("Animator") :: Animator
	return animator:LoadAnimation(animation)
end

local function setAiming(isAiming: boolean): ()
	if isAiming then
		CursorOverride.Push()
	else
		CursorOverride.Pop()
	end

	-- Bow Aim/Hold and the movement Idle/Walk/Run tracks all play at the same default Action
	-- priority, so without this they'd blend together instead of the bow pose winning cleanly.
	MovementLocked:Fire(isAiming)
end

local function TweenFOV(TargetFOV: number): ()
	if lockOnController and lockOnController:IsLocked() then
		return
	end

	if State.CurrentFOVTween then
		State.CurrentFOVTween:Cancel()
	end

	State.CurrentFOVTween = TweenService:Create(
		Camera,
		TweenInfo.new(Settings.FOVTweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ FieldOfView = TargetFOV }
	)

	State.CurrentFOVTween:Play()
end

local function StartAim(): ()
	State.Aiming = true
	Humanoid.WalkSpeed = Settings.AimWalkSpeed
	setAiming(true)

	Tracks.Aim:Play()
	Sounds.Hold:Play()
	TweenFOV(Settings.AimFOV)
end

local function StopAim(Fired: boolean): ()
	Tracks.Aim:Stop()
	Tracks.Hold:Stop()
	Sounds.Hold:Stop()

	Humanoid.WalkSpeed = State.OriginalWalkSpeed
	setAiming(false)

	if Fired then
		Sounds.Release:Play()
		Tracks.Shot:Play()
		Packets.Shoot:Fire(getShootDirection())
	else
		Sounds.Cancel:Play()
	end

	State.Aiming = false
	State.Holding = false
	TweenFOV(Settings.DefaultFOV)
end

local function StartFastAim(): ()
	if tick() - State.LastFastShotTime < Settings.FastShotCooldown then
		return
	end

	State.FastAiming = true
	State.FastShotFired = false
	Humanoid.WalkSpeed = Settings.AimWalkSpeed
	setAiming(true)

	Tracks.Aim:Play()
	Sounds.Hold:Play()
	TweenFOV(Settings.AimFOV + 20)

	Tracks.FastShot:Play()

	Tracks.FastShot:GetMarkerReachedSignal("Shoot"):Once(function()
		if not State.FastAiming then
			return
		end

		State.FastShotFired = true
		State.LastFastShotTime = tick()

		Sounds.Hold:Stop()
		Sounds.Release:Play()

		Flash:Play(Player.Character)
		Packets.Shoot:Fire(getShootDirection())

		State.FastAiming = false
		Humanoid.WalkSpeed = State.OriginalWalkSpeed
		setAiming(false)
		TweenFOV(Settings.DefaultFOV)
	end)
end

local function StopFastAim(): ()
	Tracks.Aim:Stop()
	Sounds.Hold:Stop()

	Humanoid.WalkSpeed = State.OriginalWalkSpeed
	setAiming(false)

	if not State.FastShotFired then
		Tracks.FastShot:Stop()
		Sounds.Cancel:Play()
	end

	State.FastAiming = false
	TweenFOV(Settings.DefaultFOV)
end

-- The CustomInventory toolbox addon auto-detects Tools via Character/Backpack.ChildAdded, but it
-- connects that listener to whatever character reference it captures at script-start -- which can
-- be the transient pre-R6-swap character (see RigTypeService), silently missing our bow. Hooking
-- our own (reliably correct) character reference's ChildAdded and registering explicitly sidesteps
-- that timing mismatch entirely.
local function registerWithInventory(tool: Instance): ()
	local playerGui = Player:FindFirstChild("PlayerGui")
	local customInventory = playerGui and playerGui:FindFirstChild("CustomInventory")
	local controllerScript = customInventory and customInventory:FindFirstChild("InventoryController")
	if not controllerScript then
		return
	end

	require(controllerScript.SETTINGS):newTool(tool)
end

local function onCharacterAdded(character: Model)
	Humanoid = character:WaitForChild("Humanoid") :: Humanoid
	State.OriginalWalkSpeed = Humanoid.WalkSpeed

	local animationAssets = {
		Aim = Animations["Bow Aim"] :: Animation,
		Hold = Animations["Bow Aim Hold"] :: Animation,
		Shot = Animations["Bow Aim Shot"] :: Animation,
		FastShot = Animations["Bow Fast Shot"] :: Animation,
	}

	Tracks = {
		Aim = LoadAnimation(animationAssets.Aim),
		Hold = LoadAnimation(animationAssets.Hold),
		Shot = LoadAnimation(animationAssets.Shot),
		FastShot = LoadAnimation(animationAssets.FastShot),
	}

	Tracks.Aim.Stopped:Connect(function()
		if State.Aiming then
			State.Holding = true
			Tracks.Hold:Play()
			Flash:Play(character)
			Sounds.Ready:Play()
		end
	end)

	-- CustomInventory's own Character/Backpack.ChildAdded detection already registers the tool
	-- automatically (confirmed via its own debug trace) -- this is just a redundant safety net.
	local existingTool = character:FindFirstChild("Bow")
	if existingTool then
		registerWithInventory(existingTool)
	end
	character.ChildAdded:Connect(function(child: Instance)
		if child.Name == "Bow" and child:IsA("Tool") then
			registerWithInventory(child)
		end
	end)
end

local function onEquipStateChanged(isEquipped: boolean): ()
	Equipped = isEquipped

	if not isEquipped then
		if State.Aiming then
			StopAim(false)
		end
		if State.FastAiming then
			StopFastAim()
		end

		if lockOnController then
			lockOnController:Unlock()
		end
	end

	Knit.GetController("ShiftLockController"):SetForced(isEquipped)
end

local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
	if gameProcessedEvent then
		return
	end

	if not Equipped then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		State.MouseDownTime = tick()
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		State.FastMouseDownTime = tick()
	end
end

local function onInputEnded(input: InputObject)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		if State.Aiming then
			StopAim(State.Holding)
		end

		State.MouseDownTime = 0
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if State.FastAiming then
			StopFastAim()
		end

		State.FastMouseDownTime = 0
	end
end

function BowController:KnitStart()
	lockOnController = Knit.GetController("LockOnController")

	Sounds = {
		Cancel = SoundService:WaitForChild("Cancel") :: Sound,
		Hold = SoundService:WaitForChild("Bow Hold") :: Sound,
		Release = SoundService:WaitForChild("Bow Release") :: Sound,
		Ready = SoundService:WaitForChild("Bow Ready") :: Sound,
	}

	if Player.Character then
		onCharacterAdded(Player.Character)
	end
	Player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.InputEnded:Connect(onInputEnded)
	Packets.EquipState.OnClientEvent:Connect(onEquipStateChanged)

	RunService.RenderStepped:Connect(function()
		if not Humanoid then
			return
		end

		if State.MouseDownTime > 0 and not State.Aiming and not State.FastAiming then
			if tick() - State.MouseDownTime >= Settings.HoldThreshold then
				StartAim()
			end
		end

		if State.FastMouseDownTime > 0 and not State.FastAiming and not State.Aiming then
			if tick() - State.FastMouseDownTime >= Settings.FastHoldThreshold then
				StartFastAim()
			end
		end
	end)
end

function BowController:KnitInit() end

return BowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="158">
            <Properties>
              <string name="Name">CurrencyController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local CurrencyFormat = require(Shared.CurrencyFormat)
local EconomyConfig = require(Shared.EconomyConfig)

local CurrencyController = Knit.CreateController({
	Name = "CurrencyController",
})

local RENDER_STEP_NAME = "UpdateCurrency"
local ANIMATION_DURATION = 1
local POP_SCALE = 1.2
local WAIT_SECONDS = 30

local player = Players.LocalPlayer
local displayedValue = 0

local cashConnection: RBXScriptConnection? = nil
local boundTextLabel: TextLabel? = nil
local boundUiScale: UIScale? = nil

local function disconnectCash(): ()
	if cashConnection then
		cashConnection:Disconnect()
		cashConnection = nil
	end

	boundTextLabel = nil
	boundUiScale = nil
end

local function animateValueChange(textLabel: TextLabel, targetValue: number): ()
	local startValue = displayedValue
	local startTime = os.clock()

	local function step()
		local elapsedTime = os.clock() - startTime
		local alpha = math.clamp(elapsedTime / ANIMATION_DURATION, 0, 1)
		displayedValue = startValue + (targetValue - startValue) * alpha
		textLabel.Text = CurrencyFormat.format(displayedValue)

		if alpha >= 1 then
			RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
		end
	end

	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Last.Value, step)
end

local function playPopAnimation(uiScale: UIScale): ()
	local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local enlargeTween = TweenService:Create(uiScale, tweenInfo, { Scale = POP_SCALE })
	local shrinkTween = TweenService:Create(uiScale, tweenInfo, { Scale = 1 })

	enlargeTween:Play()
	enlargeTween.Completed:Connect(function()
		shrinkTween:Play()
	end)
end

local function refreshDisplay(animate: boolean): ()
	if not boundTextLabel then
		return
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local cash = leaderstats and leaderstats:FindFirstChild(EconomyConfig.LeaderstatName)
	if not cash or not cash:IsA("IntValue") then
		return
	end

	if animate and cash.Value ~= displayedValue then
		animateValueChange(boundTextLabel, cash.Value)
		if boundUiScale then
			playPopAnimation(boundUiScale)
		end
	else
		displayedValue = cash.Value
		boundTextLabel.Text = CurrencyFormat.format(cash.Value)
	end
end

local function bindCashDisplay(textLabel: TextLabel, cash: IntValue): ()
	disconnectCash()

	local uiScale = textLabel:FindFirstChild("UIScale") :: UIScale?
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "UIScale"
		uiScale.Scale = 1
		uiScale.Parent = textLabel
	end

	boundTextLabel = textLabel
	boundUiScale = uiScale

	cashConnection = cash:GetPropertyChangedSignal("Value"):Connect(function()
		refreshDisplay(true)
	end)

	refreshDisplay(false)
end

local function tryBind(): boolean
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end

	local topBar = playerGui:FindFirstChild("TopBar")
	if not topBar then
		return false
	end

	local cashDisplay = topBar:FindFirstChild("CashDisplay")
	local textLabel = cashDisplay and cashDisplay:FindFirstChild("TextLabel")
	if not textLabel or not textLabel:IsA("TextLabel") then
		return false
	end

	if boundTextLabel == textLabel then
		refreshDisplay(false)
		return true
	end

	local leaderstats = player:FindFirstChild("leaderstats")
	local cash = leaderstats and leaderstats:FindFirstChild(EconomyConfig.LeaderstatName)
	if not cash or not cash:IsA("IntValue") then
		return false
	end

	bindCashDisplay(textLabel, cash)
	return true
end

local function setupGui(): ()
	local playerGui = player:WaitForChild("PlayerGui")
	local leaderstats = player:WaitForChild("leaderstats", WAIT_SECONDS)
	if not leaderstats then
		warn("CurrencyController: leaderstats not found")
		return
	end

	leaderstats:WaitForChild(EconomyConfig.LeaderstatName, WAIT_SECONDS)

	if tryBind() then
		return
	end

	playerGui:WaitForChild("TopBar", WAIT_SECONDS)
	tryBind()
end

local function onCharacterAdded(_character: Model): ()
	disconnectCash()
	task.defer(setupGui)
end

function CurrencyController:KnitStart()
	task.defer(setupGui)

	player.CharacterAdded:Connect(onCharacterAdded)

	local playerGui = player:WaitForChild("PlayerGui")
	playerGui.ChildAdded:Connect(function(child)
		if child.Name == "TopBar" and child:IsA("ScreenGui") then
			task.defer(tryBind)
		end
	end)

	player.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then
			task.defer(tryBind)
		end
	end)
end

function CurrencyController:KnitInit() end

return CurrencyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="159">
            <Properties>
              <string name="Name">DeathScreenController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local DeathScreenConfig = require(Shared.DeathScreenConfig)

local DeathScreenController = Knit.CreateController({
	Name = "DeathScreenController",
})

local player = Players.LocalPlayer

local overlayFrame: Frame? = nil
local timerText: TextLabel? = nil
local countdownGeneration = 0

local function hideScreen(): ()
	if overlayFrame then
		overlayFrame.Visible = false
	end
end

local function resolveGui(): boolean
	local playerGui = player:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end

	local deathScreen = playerGui:FindFirstChild("DeathScreen")
	if not deathScreen or not deathScreen:IsA("ScreenGui") then
		return false
	end

	local frame = deathScreen:FindFirstChild("Frame")
	local imageLabel = frame and frame:FindFirstChild("ImageLabel")
	local timer = imageLabel and imageLabel:FindFirstChild("TimerText")

	if not frame or not frame:IsA("Frame") or not timer or not timer:IsA("TextLabel") then
		return false
	end

	overlayFrame = frame
	timerText = timer
	return true
end

local function waitForGui(): ()
	local playerGui = player:WaitForChild("PlayerGui")
	local deathScreen = playerGui:WaitForChild("DeathScreen", 30)
	if not deathScreen then
		warn("DeathScreenController: DeathScreen ScreenGui missing from PlayerGui")
		return
	end

	deathScreen:WaitForChild("Frame", 10)
	resolveGui()
	hideScreen()
end

local function runCountdown(): ()
	if not overlayFrame or not timerText then
		if not resolveGui() then
			return
		end
	end

	countdownGeneration += 1
	local generation = countdownGeneration

	overlayFrame.Visible = true

	for secondsLeft = DeathScreenConfig.RespawnTime, 0, -1 do
		if generation ~= countdownGeneration then
			return
		end

		timerText.Text = DeathScreenConfig.TimerPrefix .. secondsLeft
		task.wait(1)
	end

	if generation == countdownGeneration then
		hideScreen()
	end
end

local function onDied(): ()
	task.spawn(runCountdown)
end

local function onCharacterAdded(character: Model): ()
	countdownGeneration += 1
	hideScreen()

	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	humanoid.Died:Connect(onDied)
end

function DeathScreenController:KnitStart()
	task.defer(waitForGui)

	if player.Character then
		onCharacterAdded(player.Character)
	end

	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			resolveGui()
			onCharacterAdded(character)
		end)
	end)

	local playerGui = player:WaitForChild("PlayerGui")
	playerGui.ChildAdded:Connect(function(child)
		if child.Name == "DeathScreen" and child:IsA("ScreenGui") then
			task.defer(function()
				resolveGui()
				hideScreen()
			end)
		end
	end)
end

function DeathScreenController:KnitInit() end

return DeathScreenController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="160">
            <Properties>
              <string name="Name">DisablePlayerSoundsController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local DisablePlayerSoundsController = Knit.CreateController({
	Name = "DisablePlayerSoundsController",
})

local player = Players.LocalPlayer

local function onCharacterAdded(character: Model): ()
	for _, obj in character:GetDescendants() do
		if obj:IsA("Sound") then
			obj:Destroy()
		end
	end

	character.DescendantAdded:Connect(function(descendant: Instance)
		if descendant:IsA("Sound") then
			-- Deferred so we don't fight the engine mid-setup while it's still parenting in.
			task.defer(function()
				if descendant.Parent then
					descendant:Destroy()
				end
			end)
		end
	end)
end

function DisablePlayerSoundsController:KnitStart()
	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)
end

function DisablePlayerSoundsController:KnitInit() end

return DisablePlayerSoundsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="161">
            <Properties>
              <string name="Name">DoubleJumpController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Packages = ReplicatedStorage.Packages
local Knit = require(Packages.Knit)

local Shared = ReplicatedStorage.Shared
local RunConfig = require(Shared.RunConfig)

local MovementLocked = ReplicatedStorage.MovementLocked

local DoubleJumpController = Knit.CreateController({
	Name = "DoubleJumpController",
})

local player = Players.LocalPlayer
local humanoid: Humanoid? = nil
local animator: Animator? = nil
local doubleJumpTrack: AnimationTrack? = nil

-- Only true once we've confirmed (after a short delay) that the first jump has settled into a
-- genuine Freefall, matching Roblox's own double-jump example -- ChangeState(Jumping) is ignored
-- if fired too early, while the engine is still mid-ascent of the first jump.
local doubleJumpArmed = false

-- True only for the single StateChanged firing caused by our own ChangeState(Jumping) retrigger
-- below, so that branch doesn't clobber the double-jump animation with the single-jump one.
local isPerformingDoubleJump = false

-- Fired by AnimationController while an Anchor = true emote (like Meditate) is active, so
-- pressing jump doesn't play a jump pose over top of the emote while the character is held in place.
local isMovementLocked = false

-- Cooldown between ground jumps only -- doesn't affect the double jump's own trigger, which is
-- gated separately by doubleJumpArmed.
local jumpOnCooldown = false

local function loadTrack(entry: typeof(RunConfig.DoubleJump), animationName: string): AnimationTrack
	local animation = Instance.new("Animation")
	animation.Name = animationName
	animation.AnimationId = entry.Id

	local track = animator:LoadAnimation(animation)
	-- Above walk/run (Action) so the jump pose reads clearly even if a move key is still held mid-air.
	track.Priority = Enum.AnimationPriority.Action2
	track.Looped = entry.Looped
	return track
end

local function onCharacterAdded(character: Model)
	humanoid = character:WaitForChild("Humanoid") :: Humanoid
	animator = humanoid:WaitForChild("Animator") :: Animator
	doubleJumpArmed = false
	jumpOnCooldown = false

	if doubleJumpTrack then
		doubleJumpTrack:Stop()
		doubleJumpTrack:Destroy()
	end

	doubleJumpTrack = loadTrack(RunConfig.DoubleJump, "DoubleJumpAnimation")

	humanoid.StateChanged:Connect(function(_old, new)
		if isMovementLocked then
			return
		end

		-- The first jump uses Roblox's own default jump animation (no override) -- only the
		-- double jump needs a custom pose, since that's not a stock Humanoid ability.
		if new == Enum.HumanoidStateType.Jumping then
			local wasDoubleJump = isPerformingDoubleJump
			isPerformingDoubleJump = false

			-- Only the natural first jump (from the ground) should ever arm the double jump --
			-- our own ChangeState(Jumping) retrigger for the double jump itself also lands in this
			-- branch, and must NOT re-arm another one, or jumping becomes unlimited.
			if not wasDoubleJump and not doubleJumpArmed then
				task.wait(0.2)
				if humanoid:GetState() == Enum.HumanoidStateType.Freefall then
					doubleJumpArmed = true
				end
			end
		elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			doubleJumpArmed = false
			-- Non-looped tracks hold their last frame forever once finished instead of releasing
			-- on their own, so the double jump pose must be stopped explicitly once we're grounded.
			if doubleJumpTrack then
				doubleJumpTrack:Stop()
			end
		end
	end)
end

local function onJumpRequest(): ()
	if isMovementLocked or not humanoid then
		return
	end

	if humanoid.FloorMaterial == Enum.Material.Air then
		-- Already airborne -- this is the double jump's territory, not the ground-jump cooldown's.
		return
	end

	if jumpOnCooldown then
		return
	end

	jumpOnCooldown = true
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	task.delay(RunConfig.JumpCooldown, function()
		jumpOnCooldown = false
	end)
end

local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
	if gameProcessedEvent or input.KeyCode ~= Enum.KeyCode.Space then
		return
	end

	if isMovementLocked or not humanoid or not doubleJumpArmed then
		return
	end

	if humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
		isPerformingDoubleJump = true
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		doubleJumpArmed = false

		if doubleJumpTrack then
			doubleJumpTrack:Play()
		end
	end
end

function DoubleJumpController:KnitStart()
	if player.Character then
		onCharacterAdded(player.Character)
	end
	player.CharacterAdded:Connect(onCharacterAdded)

	UserInputService.InputBegan:Connect(onInputBegan)
	UserInputService.JumpRequest:Connect(onJumpRequest)

	MovementLocked.Event:Connect(function(locked: boolean)
		isMovementLocked = locked
		if locked then
			if doubleJumpTrack then
				doubleJumpTrack:Stop()
			end
		end
	end)
end

function DoubleJumpController:KnitInit() end

return DoubleJumpController
]]></string>
            </Properties>
          </Item>
